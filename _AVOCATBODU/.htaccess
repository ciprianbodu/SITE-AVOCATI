Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP_HOST} !^avocatbodu\.ro$ [NC]
    RewriteRule ^ https://avocatbodu.ro%{REQUEST_URI} [L,R=301]

    # Use the visitor scheme reported by the proxy, not the proxy-to-origin scheme.
    RewriteCond %{HTTP:CF-Visitor} !^$
    RewriteCond %{HTTP:CF-Visitor} !https [NC]
    RewriteRule ^ https://avocatbodu.ro%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP:CF-Visitor} ^$
    RewriteCond %{HTTP:X-Forwarded-Proto} !^$
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://avocatbodu.ro%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP:CF-Visitor} ^$
    RewriteCond %{HTTP:X-Forwarded-Proto} ^$
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://avocatbodu.ro%{REQUEST_URI} [L,R=301]

    # GET/HEAD only: the RO contact form POSTs to index.php; a 301 would turn it into GET /
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ https://avocatbodu.ro/ [R=301,L]

    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    RewriteRule ^articole$ /articole/ [R=301,L]

    RewriteRule ^(drept-societar|drept-comercial|drept-fiscal|criminalitate-economica|drept-bancar|arbitraj-comercial|infractiuni-informatice|portofele-cripto)/?$ serviciu.php?d=$1 [L]
    RewriteRule ^(corporate-law|commercial-law|tax-law|economic-offences|banking-law|commercial-arbitration|cybercrime|crypto-wallets)/?$ serviciu.php?d=$1 [L]

    RewriteRule ^(includes|PHPmailer)/ - [F,L]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml application/ld+json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|webp|jpg|jpeg|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<FilesMatch "^(sftp\.json|config\.php|config\.example\.php|mail-config\.php|mail-config\.example\.php|webmaster-config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

AddType font/woff2 .woff2
AddType image/webp .webp
