<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <defaultDocument enabled="true">
      <files><clear /><add value="index.php" /><add value="index.html" /></files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="Block private files and folders" stopProcessing="true">
          <match url="(^|/)(\.[^/]*|partials|PHPMailer|mail-config\.php|sftp\.json|error_log)(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="Canonical host" stopProcessing="true">
          <match url=".*" />
          <conditions><add input="{HTTP_HOST}" pattern="^www\.mitescu\.ro$" negate="true" ignoreCase="true" /></conditions>
          <action type="Redirect" url="https://www.mitescu.ro/{R:0}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Require HTTPS" stopProcessing="true">
          <match url=".*" />
          <conditions><add input="{HTTPS}" pattern="^off$" ignoreCase="true" /></conditions>
          <action type="Redirect" url="https://www.mitescu.ro/{R:0}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Canonical index" stopProcessing="true">
          <match url="^index\.php$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
            <add input="{UNENCODED_URL}" pattern="^/index\.php(?:\?|$)" />
          </conditions>
          <action type="Redirect" url="https://www.mitescu.ro/" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors existingResponse="PassThrough" />
    <httpProtocol><customHeaders>
      <remove name="X-Content-Type-Options" /><add name="X-Content-Type-Options" value="nosniff" />
      <remove name="Referrer-Policy" /><add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      <remove name="X-Frame-Options" /><add name="X-Frame-Options" value="SAMEORIGIN" />
    </customHeaders></httpProtocol>
  </system.webServer>
</configuration>
