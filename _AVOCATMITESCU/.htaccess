
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^(?:\.git|\.vscode|\.claude|partials|PHPMailer)(?:/|$) - [R=404,L,NC]
RewriteRule ^(?:mail-config\.php|sftp\.json|error_log)$ - [R=404,L,NC]

RewriteCond %{HTTP_HOST} !^www\.mitescu\.ro$ [NC]
RewriteRule ^ https://www.mitescu.ro%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP:CF-Visitor} !^$
RewriteCond %{HTTP:CF-Visitor} !https [NC]
RewriteRule ^ https://www.mitescu.ro%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP:CF-Visitor} ^$
RewriteCond %{HTTP:X-Forwarded-Proto} !^$
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://www.mitescu.ro%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP:CF-Visitor} ^$
RewriteCond %{HTTP:X-Forwarded-Proto} ^$
RewriteCond %{HTTPS} off
RewriteRule ^ https://www.mitescu.ro%{REQUEST_URI} [R=301,L]

RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ https://www.mitescu.ro/ [R=301,L]
</IfModule>

###- Hosting Optimization -###
### Start
<IfModule mod_headers.c>
  Header unset ETag
  FileETag None
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/phtml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE text/javascript
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault A0
  <FilesMatch "\.(flv|ico|pdf|avi|mov|ppt|doc|mp3|wmv|wav)$">
    ExpiresDefault A29030400
    Header append Cache-Control "public"
  </FilesMatch>
  <FilesMatch "\.(gif|jpg|jpeg|js|png|swf|css)$">
    ExpiresDefault A604800
    Header append Cache-Control "public"
  </FilesMatch>
  <FilesMatch "\.(xml|txt|html)$">
    ExpiresDefault A7200
    Header append Cache-Control "proxy-revalidate"
  </FilesMatch>
  <FilesMatch "\.(php|cgi|pl|htm)$">
    ExpiresActive Off
    Header set Cache-Control "private, no-cache, no-store, proxy-revalidate, no-transform"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>
### End


# Local optimized assets.
AddType font/woff2 .woff2
AddType image/webp .webp
<IfModule mod_expires.c>
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 week"
</IfModule>
